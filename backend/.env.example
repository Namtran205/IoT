# Chay web cuc bo, khong can MQTT de thu quan ly sinh vien.
HOST=127.0.0.1
PORT=5000
DEMO_MODE=true
MQTT_ENABLED=false
MQTT_HOST=YOUR_CLUSTER.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TLS=true
MQTT_BASE_TOPIC=demo/smartgate01
DEVICE_ID=smartgate01
CAMERA_ID=CAM01

# Wi-Fi for the ESP32-CAM. Starting the dashboard prepares the Arduino config.
CAM_WIFI_SSID=
CAM_WIFI_PASSWORD=
# Optional: camera IP from CAMERA URL; can also be saved in dashboard.
# CAMERA_URL=http://192.168.137.165
# DATABASE_PATH=instance/classroom.sqlite3

